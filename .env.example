# 复制到 apps/server/.env 后填写（apps/server/.env 已 gitignore）
BUILTIN_BASE_URL=
BUILTIN_API_KEY=
BUILTIN_MODELS=
BUILTIN_CONTEXT_WINDOW=256000
BUILTIN_MAX_TOKENS=8192
# 本地模型配置 Key 的 AES-GCM 加密密钥；至少 16 个字符，设置后不要随意更换
MODEL_KEY_SECRET=
# 内部小任务（记忆标注 / 会话标题）：直接写上游模型名，不进模型列表
MEMORY_MODEL=
TITLE_MODEL=
MEMORY_LABEL_ALWAYS=0
